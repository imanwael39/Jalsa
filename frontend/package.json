{
    "name": "frontend",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "build:prod": "ng build --configuration production",
        "watch": "ng build --watch --configuration development",
        "test": "vitest",
        "test:ci": "vitest run",
        "lint": "eslint . --ext .ts,.html",
        "lint:fix": "eslint . --ext .ts,.html --fix",
        "format": "prettier --write \"**/*.{ts,html,css,json}\"",
        "prepare": "cd .. && git config core.hooksPath frontend/.husky"
    },
    "private": true,
    "packageManager": "npm@11.9.0",
    "dependencies": {
        "@angular/animations": "^21.2.16",
        "@angular/cdk": "^21.2.14",
        "@angular/common": "^21.2.0",
        "@angular/compiler": "^21.2.0",
        "@angular/core": "^21.2.0",
        "@angular/forms": "^21.2.0",
        "@angular/platform-browser": "^21.2.0",
        "@angular/router": "^21.2.0",
        "@microsoft/signalr": "^10.0.0",
        "@popperjs/core": "^2.11.8",
        "@sentry/angular": "^10.62.0",
        "bootstrap": "^5.3.8",
        "chart.js": "^4.5.1",
        "jwt-decode": "^4.0.0",
        "ng2-charts": "^10.0.0",
        "ngx-quill": "^30.1.3",
        "quill": "^2.0.3",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "^0.16.2"
    },
    "devDependencies": {
        "@analogjs/vite-plugin-angular": "^2.6.2",
        "@analogjs/vitest-angular": "^2.6.2",
        "@angular-eslint/eslint-plugin": "^22.0.0",
        "@angular-eslint/eslint-plugin-template": "^22.0.0",
        "@angular-eslint/template-parser": "^22.0.0",
        "@angular/build": "^21.2.13",
        "@angular/cli": "^21.2.13",
        "@angular/compiler-cli": "^21.2.0",
        "@commitlint/cli": "^21.1.0",
        "@commitlint/config-conventional": "^21.1.0",
        "@tailwindcss/postcss": "^4.1.12",
        "@typescript-eslint/eslint-plugin": "^8.62.0",
        "@typescript-eslint/parser": "^8.62.0",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jsdom": "^28.0.0",
        "lint-staged": "^17.0.8",
        "postcss": "^8.5.3",
        "prettier": "^3.8.4",
        "tailwindcss": "^4.1.12",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.62.0",
        "vitest": "^4.0.8"
    }
}
